<Window x:Class="DriveBench.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriveBench — Phase 1 PC Test" Width="660" Height="570" MinWidth="570" MinHeight="540" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="14" Deactivated="OnDeactivated" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="DriveBench / PC controller test" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="No phone or Wi-Fi connection yet. Start with the driver-free test." Margin="0,6,0,18" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18"><ComboBox x:Name="Backend" Width="295" SelectedIndex="0"><ComboBoxItem Content="Dry run — no controller driver"/><ComboBoxItem Content="ViGEmBus — experimental Xbox controller"/></ComboBox><Button x:Name="StartButton" Content="Start test host" Click="OnStart" Padding="14,7" Margin="12,0,0,0"/></StackPanel>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Text="Steering" VerticalAlignment="Center"/><Slider x:Name="Steering" Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ElementName=Steering, Path=Value, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <TextBlock Grid.Row="1" Text="Brake" VerticalAlignment="Center"/><Slider x:Name="Brake" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=Brake, Path=Value, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <TextBlock Grid.Row="2" Text="Throttle" VerticalAlignment="Center"/><Slider x:Name="Throttle" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=Throttle, Path=Value, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,18,0,12"><TextBlock Text="Hold Space to send; release clears input. The 5-second test also runs while you switch to the game." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="HoldButton" IsEnabled="False" Content="HOLD TO SEND" Padding="14,12" PreviewMouseLeftButtonDown="OnHoldDown" PreviewMouseLeftButtonUp="OnHoldUp" LostMouseCapture="OnLostCapture"/><Button x:Name="TimedButton" IsEnabled="False" Content="5-second game test" Click="OnTimedTest" Padding="14,12" Margin="8,0,0,0"/><Button Content="STOP / Esc" Click="OnStop" Padding="14,12" Margin="8,0,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="4"><TextBlock x:Name="Status" Text="Not connected. Dry run is selected." TextWrapping="Wrap"/><TextBlock x:Name="Output" Text="Applied: neutral" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="100 ms input lease · separate output host · prototype, Windows testing required" Foreground="#516272" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</Window>
