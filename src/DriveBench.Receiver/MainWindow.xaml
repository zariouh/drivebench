<Window x:Class="DriveBench.Receiver.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DriveBench — Wi-Fi receiver 0.3.8" Width="830" Height="590" MinWidth="680" MinHeight="530" WindowStartupLocation="CenterScreen" Background="#101922" Foreground="White" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="#101922"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="DRIVEBENCH / WI-FI" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Start here, scan the QR on your phone, approve pairing, then tap Resume." Foreground="#B4C6D2" Margin="0,6,0,12"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Adapters" MinHeight="38" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
      <Button x:Name="StartButton" Grid.Column="1" Content="Start receiver" Click="OnStart"/>
      <Button Grid.Column="2" Content="STOP / Esc" Click="OnStop" Background="#F29191"/>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><Border Background="White" Width="280" Height="280" HorizontalAlignment="Left"><Image x:Name="PairQr" Stretch="Uniform"/></Border><TextBlock x:Name="QrCaption" Text="The pairing QR appears after Start receiver." FontSize="12" Foreground="#B4C6D2" Margin="0,7,10,0"/></StackPanel>
      <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock Text="PHONE CONNECTION" FontSize="13" Foreground="#76E1C3"/>
        <TextBlock x:Name="Status" Text="Close the old DriveBench PC test app before starting this receiver." FontSize="20" Margin="0,8,0,16"/>
        <TextBlock x:Name="Output" Text="Steering 0 · Brake 0 · Throttle 0" FontSize="17" Margin="0,0,0,10"/>
        <TextBlock x:Name="Details" Foreground="#B4C6D2" Margin="0,0,0,15"/>
        <WrapPanel><Button x:Name="NewQrButton" Content="New pairing QR" IsEnabled="False" Click="OnNewQr"/><Button x:Name="CopyButton" Content="Copy pairing text" IsEnabled="False" Click="OnCopy"/></WrapPanel>
        <TextBlock x:Name="RecoveryStatus" Foreground="#76E1C3" Margin="0,8,0,0"/>
        <Button x:Name="RestartButton" Content="Restart controller" IsEnabled="False" Click="OnRestartController" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <TextBlock Text="The QR expires in 60 seconds. This preview remembers the phone only while this receiver is open." Foreground="#B4C6D2" FontSize="12" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="3" Text="If Windows asks, allow this app on Private networks. Keep both devices on the same Wi-Fi. Start this receiver before launching LFS." Foreground="#B4C6D2" Margin="0,14,0,10"/>
    <TextBlock Grid.Row="4" Text="0.3.8 prototype · Existing ViGEm driver · Authenticated local input · No cloud account" FontSize="11" Foreground="#8AA2B3"/>
  </Grid>
</Window>
